web: uvicorn eaaicproject.asgi:application --host 0.0.0.0 --port $PORT
worker: celery -A eaaicproject worker -Q general --concurrency=${GENERAL_WORKER_CONCURRENCY:-2} --loglevel=info
imageworker: celery -A eaaicproject worker -Q images --concurrency=${IMAGE_WORKER_CONCURRENCY:-2} --loglevel=info
beat: celery -A eaaicproject beat --loglevel=info --scheduler celery.beat.PersistentScheduler
# Agent Gateway service: /api/v1/{models,chat/completions} plus unchanged
# /api/v1/agent/* aliases. Set SERVE_AGENT_ONLY=true on this Railway service.
# Same code, DB and Redis; a larger separate worker pool handles agent traffic.
agent: uvicorn eaaicproject.asgi:application --host 0.0.0.0 --port $PORT --workers ${AGENT_WORKER_COUNT:-8}
