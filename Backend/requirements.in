# --- Test tooling ---
# Lets Django's parallel test runner pickle tracebacks across worker
# subprocesses. Without it, any per-test AssertionError is re-raised as an
# unpicklable traceback that kills the worker and cascades as
# OperationalError('database "test_test_db_N" does not exist') across every
# other test in that worker.
tblib==3.0.0

# --- Security floors for transitive dependencies ---
# Not imported directly. Each is pinned to the lowest patched release that clears
# a known advisory so pip-compile can never resolve back to a vulnerable version.
# Drop a floor only once no dependency can select below it.
click>=8.3.3          # PYSEC-2026-2132
idna>=3.15            # PYSEC-2026-215
msgpack>=1.2.1        # GHSA-6v7p-g79w-8964
pyasn1>=0.6.4         # PYSEC-2026-3455, PYSEC-2026-3456, PYSEC-2026-3457
PyJWT>=2.13.0         # PYSEC-2026-175 .. PYSEC-2026-179
urllib3>=2.7.0        # PYSEC-2026-141, PYSEC-2026-142

